{
  "name": "@far-analytics/port-peer",
  "version": "1.0.2",
  "description": "A RPC-like facility for making inter-thread function calls.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "test"
  ],
  "scripts": {
    "clean": "rm -rf ./dist/*",
    "build": "tsc --build .",
    "clean:build": "npm run clean && npm run build",
    "lint": "eslint src",
    "lint:all": "eslint .",
    "format": "prettier --write .",
    "format:lint": "npm run format && npm run lint",
    "check": "npm run lint:all && npm test",
    "prepack": "npm run clean:build",
    "test": "npm run clean:build && npm run test --workspace ./test",
    "watch": "tsc --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamjpatterson/port-peer.git"
  },
  "author": "FAR",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adamjpatterson/port-peer/issues"
  },
  "homepage": "https://github.com/adamjpatterson/port-peer#readme",
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@types/node": "^20.11.28",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "keywords": [
    "api",
    "concurrency",
    "ipc",
    "marshal",
    "multithreaded",
    "multithreading",
    "parallelism",
    "rpc",
    "scalable",
    "thread",
    "threads",
    "web",
    "worker"
  ],
  "type": "commonjs"
}
